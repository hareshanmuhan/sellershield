# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > SellerShield)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional: webhook ID from the dashboard, used to verify incoming webhooks
PAYPAL_WEBHOOK_ID=

# Gemini key from https://aistudio.google.com/apikey (starts with AIza)
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash
